<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#263A72"/>
            <corners android:radius="@dimen/_14sdp"/>
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#202F5C"/>
            <corners android:radius="@dimen/_14sdp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141A2B"/>
            <corners android:radius="@dimen/_14sdp"/>
            <stroke
                android:width="1dp"
                android:color="#293557"/>
        </shape>
    </item>

</selector>
