<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp"/>
            <solid android:color="#25365B"/>
            <stroke android:width="1dp" android:color="#5C7FBA"/>
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="16dp"/>
            <solid android:color="#0C1324"/>
            <stroke android:width="1dp" android:color="#2E405F"/>
        </shape>
    </item>

</selector>
