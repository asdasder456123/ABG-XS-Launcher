<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <corners android:radius="18dp"/>
            <solid android:color="#263B62"/>
            <stroke android:width="1dp" android:color="#6386C0"/>
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="18dp"/>
            <solid android:color="#121B2D"/>
            <stroke android:width="1dp" android:color="#293B5A"/>
        </shape>
    </item>

</selector>
