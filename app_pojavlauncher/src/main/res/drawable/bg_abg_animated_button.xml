<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#405CFF" />
            <padding
                android:left="18dp"
                android:top="12dp"
                android:right="18dp"
                android:bottom="12dp" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#263653" />
            <stroke
                android:width="1dp"
                android:color="#405CFF" />
            <padding
                android:left="18dp"
                android:top="12dp"
                android:right="18dp"
                android:bottom="12dp" />
        </shape>
    </item>

</selector>
